# Rock Band Drums MIDI Controller Configuration

# MIDI Output Port Name (created via Audio MIDI Setup on Mac)
MIDI_PORT_NAME=Rock Band Drums

# Drum mapping - game-based | realistic
DRUM_MAPPING_MODE=game-based

# Device Configuration
# Leave blank to auto-detect, or specify exact device if multiple connected
DEVICE_VENDOR_ID=0x12ba
DEVICE_PRODUCT_ID=0x0210

# Polling Configuration
POLL_RATE_HZ=60
DEBOUNCE_MS=50

# Velocity Configuration
USE_PRESSURE_VELOCITY=false
DEFAULT_VELOCITY=100

# Logging
LOG_LEVEL=info
LOG_HID_DATA=false

# Debug Mode
DEBUG=false
